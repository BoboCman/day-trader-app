{
  "name": "Leveraged ETF dip alerts",
  "nodes": [
    {
      "id": "1",
      "name": "Weekdays 3:40 PM ET",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "40 15 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "2",
      "name": "Get signals",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "https://YOUR-APP.vercel.app/api/signals",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "3",
      "name": "Market open?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.marketOpen }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "4",
      "name": "Write explanation",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        680,
        -20
      ],
      "parameters": {
        "promptType": "define",
        "text": "=You write a short daily trading alert email for one person who trades 3x leveraged ETFs by hand at Fidelity.\n\nThe JSON below comes from a rules engine. The signals are final: never change, add or second-guess a BUY or EXIT. Your job is only to explain them in plain English.\n\nWrite plain text, under 200 words:\n1. First line: what to do today. If there are BUY signals, list each fund with its suggested limit price and the full and half share counts. If none, say \"No new buys today.\"\n2. One or two sentences per BUY on why it triggered (which rule, the numbers).\n3. One line listing any funds where exit conditions are met, labelled \"If you are holding\".\n4. A short \"Market backdrop\" paragraph using only the numbers in the JSON (day change, distance from the 200-day average, RSI). Do not mention news, earnings or anything not in the data.\n5. End with: \"Rules-based alert, not advice. Check the price before placing the order.\"\n\nIf errorCount is above 0, say which funds had data errors.\n\nData:\n{{ JSON.stringify($('Get signals').item.json, null, 2) }}"
      }
    },
    {
      "id": "5",
      "name": "Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        680,
        200
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-5-5"
        },
        "options": {
          "maxTokensToSample": 800,
          "temperature": 0.2
        }
      }
    },
    {
      "id": "6",
      "name": "Email me",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        960,
        -20
      ],
      "parameters": {
        "sendTo": "YOUR_EMAIL@example.com",
        "subject": "={{ $('Get signals').item.json.subject }}",
        "emailType": "text",
        "message": "={{ $json.text }}\n\n---\nRaw numbers:\n{{ $('Get signals').item.json.summary }}",
        "options": {
          "appendAttribution": false
        }
      }
    }
  ],
  "connections": {
    "Weekdays 3:40 PM ET": {
      "main": [
        [
          {
            "node": "Get signals",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get signals": {
      "main": [
        [
          {
            "node": "Market open?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Market open?": {
      "main": [
        [
          {
            "node": "Write explanation",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Claude": {
      "ai_languageModel": [
        [
          {
            "node": "Write explanation",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Write explanation": {
      "main": [
        [
          {
            "node": "Email me",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "America/New_York",
    "executionOrder": "v1"
  },
  "pinData": {}
}