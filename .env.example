# Copy to .env.local for local dev. In Vercel, add these under Project Settings > Environment Variables.

# Alpaca market data (free account: https://alpaca.markets). Paper-trading keys work.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Shared secret that n8n sends as "Authorization: Bearer <value>". Make it long and random.
SIGNALS_API_KEY=

# Optional overrides
# POSITION_SIZE_USD=25000
